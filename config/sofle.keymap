#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define NAVLEFT 1
#define NAVRIGHT 2
#define NUMBERS 3
#define SYMBOLS 4
#define MOUSE 5
#define DEV 6
#define SYSTEM 7
#define QWERTY 8

#include "includes/keys.h"

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_R THUMBS >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MOD_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_L THUMBS >; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };
};

&mt {
  tapping-term-ms = <190>;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <190>;
  quick-tap-ms = <165>;
};

/ {

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Colemak";
// ------------------------------------------------------------------------------------------------------------
// |       |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
// |       |  Q  |  W  |  F   |  P   |  B   |                   |  J   |  L    |  U    |  Y   |   '   |   -   |
// |  ESC  |  A  |  R  |  S   |  T   |  G   |                   |  M   |  N    |  E    |  I   |   O   |   ;   |
// |  TAB  |  Z  |  X  |  C   |  D   |  V   |  MUTE  |  |       |  K   |  H    |  ,    |  .   |   /   |   _   |
//               |     |      | BSPC | SPACE|  ENTER |  | SPACE | ENTER| DEL   |       |      |
            bindings = <
&none     &kp N1       &kp N2       &kp N3        &kp N4         &kp N5                                     &kp N6           &kp N7         &kp N8        &kp N9       &kp N0       &none
&none     &kp Q        &kp W        &kp F         &kp P          &kp B                                      &kp J            &kp L          &kp U         &kp Y        &kp SQT      &kp BSPC
&kp ESC   &hml LGUI A  &hml LALT R  &hml LCTRL S  &hml LSHIFT T  &kp G                                      &kp M            &hmr RSHIFT N  &hmr RCTRL E  &hmr RALT I  &hmr RGUI O  &kp SEMI
&kp TAB   &kp Z        &kp X        &kp C         &kp D          &kp V             &kp C_MUTE    &none      &kp K            &kp H          &kp COMMA     &kp DOT      &kp FSLH     &kp UNDER
                       &none        &none         &kp BSPC       &lt NAVLEFT SPACE &to NUMBERS   &kp SPACE  &lt NAVRIGHT RET &kp DEL        &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        navleft_layer {
            display-name = "NavLeft";

// ------------------------------------------------------------------------------------------------------------
// |       |        |        |        |         |          |                   |      |         |        |       |       |       |
// |       |  PgUp  |  Home  |  Up    |  End    |  Ins     |                   |      |         |        |       |       |       |
// |       |  PgDn  |  Left  |  Down  |  Right  |  CapsWord|                   |      |  SHIFT  |  CTRL  |  ALT  |  GUI  |       |
// |       |  Undo  |  Cut   |  Copy  |  Paste  |  Redo    |        |  |       |      |         |        |       |       |       |
//                  |        |        |         |          |        |  |       |      |         |        |       |
            bindings = <
&none     &trans      &trans      &trans      &trans        &trans                            &trans    &trans      &trans      &trans      &trans      &trans
&trans    &kp PG_UP   &kp HOME    &kp UP      &kp END       &kp INS                           &trans    &trans      &trans      &trans      &trans      &trans
&trans    &kp PG_DN   &kp LEFT    &kp DOWN    &kp RIGHT     &caps_word                        &trans    &kp LSHIFT  &kp LCTRL   &kp LALT    &kp LGUI    &trans
&trans    &kp LC(Z)   &kp LC(X)   &kp LC(C)   &kp LC(V)     &kp LS(LC(Z)) &trans    &trans    &trans    &trans      &trans      &trans      &trans      &trans
                      &trans      &trans      &trans        &trans        &trans    &trans    &trans    &trans      &trans      &trans
            >;
        };

        navright_layer {
            display-name = "NavRight";

// ------------------------------------------------------------------------------------------------------------
// |       |        |        |        |         |        |                   |          |         |        |       |       |       |
// |       |        |        |        |         |        |                   | Ins      |  End    |  Up    | Home  | PgUp  |       |
// |       |  GUI   |  ALT   |  CTRL  |  SHIFT  |        |                   | CapsWord |  Right  |  Down  | Left  |  PgDn |       |
// |       |        |        |        |         |        |        |  |       | Redo     |  Paste  |  Copy  |  Cut  | Undo  |       |
//                  |        |        |         |        |        |  |       |          |         |        |       |
            bindings = <
&trans    &trans      &trans      &trans      &trans        &trans                            &trans        &trans     &trans      &trans      &trans      &none
&trans    &trans      &trans      &trans      &trans        &trans                            &kp INS       &kp HOME   &kp UP      &kp END     &kp PG_UP   &trans
&trans    &kp LGUI    &kp LALT    &kp LCTRL   &kp LSHIFT    &trans                            &caps_word    &kp LEFT   &kp DOWN    &kp RIGHT   &kp PG_DN   &trans
&trans    &trans      &trans      &trans      &trans        &trans      &trans    &trans      &kp LS(LC(Z)) &kp LC(V)  &kp LC(C)   &kp LC(X)   &kp LC(Z)   &trans
                      &trans      &trans      &trans        &trans      &trans    &trans      &trans        &trans     &trans      &trans
            >;
        };

        number_layer {
            display-name = "Numbers";
// ------------------------------------------------------------------------------------------------------------
// |       |       |       |        |        |      |                   |      |       |       |      |       |       |
// |       |  1    |  2    |  3     |  4     |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
// |   =   |  GUI  |  ALT  |  CTRL  |  SHIFT |      |                   |  *   |  4    |  5    |  6   |   +   |   =   |
// |       |       |       |        |        |      |        |  |       |  /   |  1    |  2    |  3   |   -   |   ,   |
//                 |       |        |  BKSPC | SPACE|  Base  |  |   .   |  0   |  DEL  |       |      |
            bindings = <
&none     &trans    &trans    &trans      &trans      &trans                       &trans    &trans   &trans   &trans   &trans    &trans
&none     &kp N1    &kp N2    &kp N3      &kp N4      &kp N5                       &kp N6    &kp N7   &kp N8   &kp N9   &kp N0    &kp F12
&kp EQUAL &kp LGUI  &kp LALT  &kp LCTRL   &kp LSHIFT  &none                        &kp CARET &kp N4   &kp N5   &kp N6   &kp PLUS  &kp EQUAL
&trans    &none     &none     &none       &none       &none      &none    &none    &kp FSLH  &kp N1   &kp N2   &kp N3   &kp MINUS &kp COMMA
                    &none     &none       &kp BSPC    &kp SPACE  &to 0    &kp DOT  &kp N0    &kp DEL  &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

    };
};
